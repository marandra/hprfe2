def _process_arguments(args):
    """
    Process arguments

    Parameters:
        args: arguments dictionary generated by docopts

    Return:
        string with keyword
    """

    # Debug:
    # from pprint import pprint
    # pprint(args)

    keyword = ""

    if args["init"]:
        if args["help"]:
            keyword = "INIT_HELP"
        else:
            keyword = "INIT"

    if args["deploy"]:
        if args["help"]:
            keyword = "DEPLOY_HELP"
        else:
            keyword = "DEPLOY"

    if args["generate"]:
        if args["help"]:
            keyword = "GENERATE_HELP"
        else:
            keyword = "GENERATE"

    return keyword


def init(template_path, params_quiet_flag):
    """\
Writes and creates initial files and directory structure at root path.
Root path can be passed when invoking the command, if missing the current
directory (".") is assumed.

- Checks if configurarion file is present
- If missing, writes a file with default values
- Checks template case files exists (including no-output parameters file if params_quiet
  option is set)
- Creates sampling directory (location passed as argument)
- Copies template files to sampling directory
"""

    # Write initial configuration file
    conf_file = C.root_path / "configuration.json"
    if conf_file.is_file():
        print("File {} exists. Skipping.".format(conf_file))
    else:
        C.dump_config(conf_file)
        print("Written configuration file {}.".format(conf_file))

    # Check that Kratos case files exist
    paths = [
        template_path / "MainKratos.py",
        template_path / "model.mdpa",
        template_path / "materials.json",
        template_path / "ProjectParameters.json",
        template_path / C.config["training_strain_fname"],
    ]
    if params_quiet_flag:
        paths.append(template_path / "ProjectParameters_quiet.json",)

    for p in paths:
        if not p.exists():
            print("Missing template file {}. Aborting.".format(p))
            exit()

    # Create sampling dir and copy Kratos case files from template directory
    if not C.training_path.exists():
        C.training_path.mkdir()
        print("Created sampling directory {}".format(C.training_path))
    else:
        print("Directory {} exists. Skipping.".format(C.training_path))

    # Copy template files to sampling directory
    for src in paths:
        dest = C.training_path / src.name
        dest.write_text(src.read_text())
    print("Template files copied to sampling directory")

    # Create bases dir
    if not C.bases_path.exists():
        C.bases_path.mkdir()
        print("Created bases directory {}".format(C.bases_path))
    else:
        print("Directory {} exists. Skipping.".format(C.bases_path))

    return


def deploy():
    """\
Creates file structure for sampling and directory structure for training.
Requires a file with strain tensors (voigt notation) for each trajectory.
sample create: creates directory structure
sample deploy: populates directories"""

    strain_set = C.parse_training_strain_set()

    for i, line in enumerate(strain_set):
        case_path = C.training_path / C.case_name(i)
        strain_vector = [float(x) for x in line.split()]
        sampling.create_case_dir(case_path, strain_vector)
        sampling.create_run_script(case_path)
        print(case_path.name, strain_vector)
    sampling.create_launchers(C.training_path)


def generate():
    """\
Creates file structure from the computation of bases
"""
    logger.info("Beginning bases calculation -----------------------")

    #
    # removing cases from training dataset
    # TODO: add TRAINING set and TEST set as memebers of Common
    #
    training_set = []
    for c in B.training_path.glob(B.config["case_path_pattern"].format("*")):
        c_id = int(c.name.split("_")[1])
        if c_id in B.config["cases_test_dataset"]:
            logger.info("Removing case {} from training dataset".format(c.name))
            continue
        training_set.append(c)

    #
    # generate missing local bases
    #
    B.generate_missing_local_bases(B.config["energy_name"],)
    B.generate_missing_local_bases(B.config["strain_name"],)
    B.generate_missing_local_bases(B.config["rvalue_name"],)

    #
    # compute bases
    #
    B.create_bases(
        B.config["energy_name"],
        B.config["energy_elastic_modes"],
        B.config["energy_inelastic_modes"],
        training_set,
        B.config["bases_fname_pattern"],
        B.svd_cutoff[B.config["energy_name"]],
    )
    B.create_bases(
        B.config["strain_name"],
        B.config["strain_elastic_modes"],
        B.config["strain_inelastic_modes"],
        training_set,
        B.config["bases_fname_pattern"],
        B.svd_cutoff[B.config["strain_name"]],
    )
    B.create_bases(
        B.config["rvalue_name"],
        B.config["rvalue_elastic_modes"],
        B.config["rvalue_inelastic_modes"],
        training_set,
        B.config["bases_fname_pattern"],
        B.svd_cutoff[B.config["rvalue_name"]],
    )

    logger.info("Finished -----------------------------------------")


